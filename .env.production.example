# Copy this file to ".env" ON THE SERVER and fill the values. Never commit the real .env.

# the address of the system (the domain you bought, without https://)
DOMAIN=app.mystore.com.br

# long and random: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# signs the login tokens; if it leaks anyone can log in: openssl rand -hex 32
SECRET_KEY=change-me

# how long a login lasts (minutes): 720 = 12 hours
ACCESS_TOKEN_EXPIRE_MINUTES=720

# how many stores this installation may have (the customer's plan)
MAX_STORES=2
